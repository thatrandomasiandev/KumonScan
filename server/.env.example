CENTER_TIMEZONE=America/Los_Angeles
# Display name / slug for the original center seeded by the multi-center migration.
# CENTER_NAME=KumonScan Center
# DEFAULT_CENTER_SLUG=main
PORT=3001
# One-time seed of the original center's admin_password_hash. After the first
# successful migration the database row is authoritative; changing this env
# var later does not rotate the password.
ADMIN_PASSWORD=replace-with-a-strong-password
# Platform operator credential for POST /api/centers (distinct from every
# center's admin password). Unset = provisioning returns 503.
# SUPERADMIN_KEY=
# Neon Postgres (required). Use the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional: separate secret for signing admin cookies (defaults to ADMIN_PASSWORD).
# ADMIN_SESSION_SECRET=
# Comma-separated browser origins for credentialed CORS (dev defaults if unset).
# Production same-origin on Vercel usually needs no extra origins; add preview URLs if needed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# Static bearer token for the Android SMS gateway phone (see gateway-app/).
# Unset = gateway endpoints return 503 and check-in/out SMS rows queue up unsent.
# GATEWAY_API_KEY=
# Zoom webhook secret token for automatic remote-attendance tracking.
# Unset = POST /api/webhooks/zoom returns 503; staff log remote sessions
# manually via the desk check-in Remote toggle instead.
# ZOOM_WEBHOOK_SECRET=
# WhatsApp Cloud API (agent-8). Outbound needs ACCESS_TOKEN + PHONE_NUMBER_ID;
# inbound webhook needs VERIFY_TOKEN + APP_SECRET. Unset = channel disabled,
# check-in/out fall back to SMS when WhatsApp is preferred.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Tests only: Neon test-suite branch connection string (never the production branch).
# TEST_DATABASE_URL=
# NODE_ENV=production
