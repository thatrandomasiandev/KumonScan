CENTER_TIMEZONE=America/Los_Angeles
PORT=3001
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: persistent DB directory (Railway volume → /data)
# DATA_DIR=/data
# NODE_ENV=production

# Vonage SMS (pickup on check-out). All three required; SMS stays off if any are missing.
# VONAGE_FROM must be an SMS-capable number from the Vonage Numbers dashboard (E.164).
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
